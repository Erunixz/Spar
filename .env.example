# Copy to .env (git-ignored) and fill in. Nothing is required yet.
#
# VITE_* variables are bundled into the browser build, so they must never
# hold secrets. Server secrets (e.g. GitHub OAuth client secret) go in
# apps/api/.dev.vars for wrangler, which is also git-ignored.

# Base URL of the sync API (Phase 5). Leave empty to run fully local.
VITE_API_URL=

# Folder containing pattern-classifier-v1/ (Model #1). Empty = served by the app itself
# (dev: from ml/artifacts). Point at the Hugging Face repo once it's published.
VITE_PATTERN_MODEL_URL=
